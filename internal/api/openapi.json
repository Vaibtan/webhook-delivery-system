    "/status/metrics/summary": {
      "get": {
        "summary": "Delivery metrics summary",
        "description": "Aggregate delivery counts over a recent time window.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "hours",
            "in": "query",
            "required": false,
            "description": "Size of the look-back window in hours.",
            "schema": {
              "type": "integer",
              "default": 24,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Aggregate delivery metrics.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "window_hours": {
                      "type": "integer"
                    },
                    "total_attempts": {
                      "type": "integer"
                    },
                    "successful": {
                      "type": "integer"
                    },
                    "failed": {
                      "type": "integer"
                    },
                    "pending": {
                      "type": "integer"
                    },
                    "final_failure": {
                      "type": "integer"
                    },
                    "success_rate": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "window_hours",
                    "total_attempts",
                    "successful",
                    "failed",
                    "pending",
                    "final_failure",
                    "success_rate"
                  ]
                },
                "example": {
                  "window_hours": 24,
                  "total_attempts": 1200,
                  "successful": 1150,
                  "failed": 40,
                  "pending": 5,
                  "final_failure": 5,
                  "success_rate": 0.958
                }
              }
            }
          }
        }
      }
    },
    "/monitor": {
      "get": {
        "summary": "System health and metrics",
        "description": "Return system-level health, queue depths, circuit breaker states, and delivery latency metrics.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "System monitoring snapshot.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "uptime_seconds": {
                      "type": "integer"
                    },
                    "current_time": {
                      "type": "string"
                    },
                    "delivery_metrics": {
                      "type": "object",
                      "description": "Counts keyed by delivery status, including a 'total' key.",
                      "additionalProperties": {
                        "type": "integer"
                      }
                    },
                    "queue_depth": {
                      "type": "integer"
                    },
                    "dead_letter_queue_depth": {
                      "type": "integer"
                    },
                    "circuit_breakers": {
                      "type": "object",
                      "description": "Circuit breaker state keyed by target URL.",
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "delivery_latency_ms": {
                      "type": "object",
                      "properties": {
                        "count": {
                          "type": "integer"
                        },
                        "min": {
                          "type": "integer"
                        },
                        "max": {
                          "type": "integer"
                        },
                        "avg": {
                          "type": "integer"
                        },
                        "p50": {
                          "type": "integer"
                        },
                        "p95": {
                          "type": "integer"
                        },
                        "p99": {
                          "type": "integer"
                        }
                      },
                      "required": [
                        "count",
                        "min",
                        "max",
                        "avg",
                        "p50",
                        "p95",
                        "p99"
                      ]
                    }
                  },
                  "required": [
                    "uptime_seconds",
                    "current_time",
                    "delivery_metrics",
                    "queue_depth",
                    "dead_letter_queue_depth",
                    "circuit_breakers",
                    "delivery_latency_ms"
                  ]
                },
                "example": {
                  "uptime_seconds": 86400,
                  "current_time": "2026-06-21T10:00:00Z",
                  "delivery_metrics": {
                    "total": 1200,
                    "success": 1150,
                    "failed": 40,
                    "pending": 10
                  },
                  "queue_depth": 3,
                  "dead_letter_queue_depth": 1,
                  "circuit_breakers": {
                    "https://example.com/webhooks": "closed"
                  },
                  "delivery_latency_ms": {
                    "count": 1200,
                    "min": 12,
                    "max": 980,
                    "avg": 85,
                    "p50": 70,
                    "p95": 240,
                    "p99": 600
                  }
                }
              }
            }
          }
        }
      }
    }
  }
