    "/subscriptions/{id}/replay/{webhook_id}": {
      "post": {
        "summary": "Replay a dead-lettered webhook",
        "description": "Replay a webhook from the dead-letter queue as a new delivery chain.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The subscription that owns the webhook.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "webhook_id",
            "in": "path",
            "required": true,
            "description": "The webhook to replay.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Replay accepted; a new delivery chain has been created.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "webhook_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "delivery_id": {
                      "type": "string",
                      "format": "uuid",
                      "description": "The new delivery chain id."
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "replaying"
                      ]
                    }
                  },
                  "required": [
                    "webhook_id",
                    "delivery_id",
                    "status"
                  ]
                },
                "example": {
                  "webhook_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                  "delivery_id": "7c9e6679-7425-40de-944b-e07fc1f90ae7",
                  "status": "replaying"
                }
              }
            }
          },
          "404": {
            "description": "No dead-letter entry found for this webhook.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/subscriptions/{id}/dlq/{webhook_id}/ack": {
      "post": {
        "summary": "Acknowledge a dead-letter entry",
        "description": "Discard / acknowledge a dead-letter queue entry so it is no longer pending.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The subscription that owns the webhook.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "webhook_id",
            "in": "path",
            "required": true,
            "description": "The dead-lettered webhook to acknowledge.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dead-letter entry acknowledged.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "webhook_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "acknowledged"
                      ]
                    }
                  },
                  "required": [
                    "webhook_id",
                    "status"
                  ]
                },
                "example": {
                  "webhook_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                  "status": "acknowledged"
                }
              }
            }
          },
          "404": {
            "description": "No dead-letter entry found for this webhook.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
