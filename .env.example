# Example environment for the Go webhook delivery service.
# Copy to a local .env (gitignored) or export these before `go run ./cmd/server`.
# Values shown are typical local-dev values, not always the built-in code defaults — a few
# (ALLOW_HTTP_URLS, CORS_ALLOWED_ORIGINS, ADMIN_API_KEY) differ from their defaults. REQUIRED
# vars have no default and must be set. See internal/config/config.go.

# --- Required infrastructure -------------------------------------------------
DATABASE_URL=postgres://webhook:webhook@localhost:5432/webhook?sslmode=disable   # REQUIRED — Postgres DSN
REDIS_URL=redis://localhost:6379/0                                               # REQUIRED — queue, scheduler, DLQ, cache

# --- HTTP server -------------------------------------------------------------
PORT=8080

# --- Auth --------------------------------------------------------------------
# Bearer token for the admin/management routes. Fails closed (503) if unset; wrong/missing token gives 401.
ADMIN_API_KEY=dev-admin-key

# --- Delivery / worker pool --------------------------------------------------
WEBHOOK_TIMEOUT=10s
WORKER_CONCURRENCY=50
PER_SUB_CONCURRENCY=5
DRAIN_TIMEOUT=30s

# --- Retry / backoff ---------------------------------------------------------
MAX_RETRY_ATTEMPTS=5
RETRY_BASE_DELAY=10s
RETRY_MAX_DELAY=15m

# --- Recovery / lease --------------------------------------------------------
VISIBILITY_TIMEOUT=60s
ORPHAN_THRESHOLD=15m
RECOVERY_SCAN_INTERVAL=5m

# --- Retention / DLQ ---------------------------------------------------------
LOG_RETENTION_HOURS=72
DLQ_MAX_AGE=720h
IDEMPOTENCY_TTL=5m

# --- Caching / in-memory registries ------------------------------------------
CACHE_TTL=5m
REGISTRY_IDLE_TTL=1h

# --- Rate limiting (per subscription) ----------------------------------------
RATE_LIMIT_PER_SEC=100
RATE_LIMIT_BURST=200

# --- Circuit breaker (per endpoint) ------------------------------------------
BREAKER_THRESHOLD=5
BREAKER_RESET_TIMEOUT=30s

# --- Auto-disable ------------------------------------------------------------
AUTO_DISABLE_THRESHOLD=5

# --- Signing / secrets -------------------------------------------------------
SIGNATURE_DRIFT_WINDOW=5m
SECRET_GRACE_WINDOW=24h

# --- Behavioural toggles -----------------------------------------------------
ALLOW_HTTP_URLS=true     # permit non-HTTPS targets (local dev only; default false)
SYNC_DELIVERY=false      # first attempt in request; retries still run in background
ENABLE_PPROF=false       # mount /api/v1/debug/pprof/

# --- API / CORS --------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
